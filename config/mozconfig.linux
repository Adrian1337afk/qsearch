# qsearch build configuration (Linux x86_64, Firefox ESR base)
# Same flags as config/mozconfig, minus the Windows-only ones.

ac_add_options --enable-application=browser
ac_add_options --target=x86_64-pc-linux-gnu

# Identity
ac_add_options --with-app-name=qsearch
ac_add_options --with-branding=browser/branding/qsearch
export MOZ_APP_REMOTINGNAME=qsearch

# Release-quality build
ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --enable-release
ac_add_options --enable-hardening
ac_add_options --enable-rust-simd
ac_add_options --disable-tests

# Nothing phones home
# (--disable-default-browser-agent and --disable-maintenance-service are
#  Windows-only: neither component exists on Linux.)
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --enable-update-channel=release

export MOZ_TELEMETRY_REPORTING=
mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0

# Build output stays inside the source tree
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-qsearch-linux
