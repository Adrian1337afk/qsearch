{
  "policies": {
    "AppUpdateURL": "https://localhost",
    "DisableAppUpdate": true,
    "DisableDefaultBrowserAgent": true,
    "DisableFeedbackCommands": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableTelemetry": true,
    "DontCheckDefaultBrowser": true,
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "SkipTermsOfUse": true,
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true
      },
      "gdpr@cavi.au.dk": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/consent-o-matic/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true
      }
    },
    "SearchEngines": {
      "Default": "DuckDuckGo",
      "PreventInstalls": false,
      "Add": [
        {
          "Name": "Qwant",
          "Alias": "!qw",
          "Method": "GET",
          "URLTemplate": "https://www.qwant.com/?q={searchTerms}",
          "Description": "Qwant",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Ecosia",
          "Alias": "!eco",
          "Method": "GET",
          "URLTemplate": "https://www.ecosia.org/search?q={searchTerms}",
          "Description": "Ecosia",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Startpage",
          "Alias": "!sp",
          "Method": "GET",
          "URLTemplate": "https://www.startpage.com/sp/search?query={searchTerms}",
          "Description": "Startpage",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Brave Search",
          "Alias": "!brave",
          "Method": "GET",
          "URLTemplate": "https://search.brave.com/search?q={searchTerms}",
          "Description": "Brave Search",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "YouTube",
          "Alias": "!yt",
          "Method": "GET",
          "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}",
          "Description": "YouTube",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "GitHub",
          "Alias": "!gh",
          "Method": "GET",
          "URLTemplate": "https://github.com/search?q={searchTerms}",
          "Description": "GitHub",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Reddit",
          "Alias": "!r",
          "Method": "GET",
          "URLTemplate": "https://www.reddit.com/search/?q={searchTerms}",
          "Description": "Reddit",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Stack Overflow",
          "Alias": "!so",
          "Method": "GET",
          "URLTemplate": "https://stackoverflow.com/search?q={searchTerms}",
          "Description": "Stack Overflow",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "MDN Web Docs",
          "Alias": "!mdn",
          "Method": "GET",
          "URLTemplate": "https://developer.mozilla.org/en-US/search?q={searchTerms}",
          "Description": "MDN Web Docs",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "OpenStreetMap",
          "Alias": "!osm",
          "Method": "GET",
          "URLTemplate": "https://www.openstreetmap.org/search?query={searchTerms}",
          "Description": "OpenStreetMap",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "IMDb",
          "Alias": "!imdb",
          "Method": "GET",
          "URLTemplate": "https://www.imdb.com/find/?q={searchTerms}",
          "Description": "IMDb",
          "IconURL": "data:image/png;base64,"
        }
      ],
      "Remove": [
        "Google",
        "Bing",
        "Perplexity"
      ]
    },
    "FirefoxHome": {
      "Search": true,
      "TopSites": true,
      "SponsoredTopSites": false,
      "Highlights": false,
      "Pocket": false,
      "Stories": false,
      "SponsoredPocket": false,
      "SponsoredStories": false,
      "Snippets": false,
      "Weather": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "ImproveSuggest": false
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false,
      "FirefoxLabs": false
    }
  }
}
